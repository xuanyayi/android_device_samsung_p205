<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Keep the single mobile radio on non-IMS data bearers. Samsung's stock
         IMS stack is private and is not currently integrated on this build. -->
    <string-array translatable="false" name="networkAttributes">
        <item>"wifi,1,1,1,-1,true"</item>
        <item>"mobile,0,0,0,-1,true"</item>
        <item>"mobile_mms,2,0,2,240000,true"</item>
        <item>"mobile_supl,3,0,2,60000,true"</item>
        <item>"mobile_dun,4,0,2,60000,true"</item>
        <item>"mobile_hipri,5,0,3,60000,true"</item>
        <item>"mobile_ims,11,0,2,60000,true"</item>
        <item>"bluetooth,7,7,0,-1,true"</item>
        <item>"ethernet,9,9,2,-1,true"</item>
        <item>"mobile_fota,10,0,2,60000,true"</item>
        <item>"mobile_cbs,12,0,2,60000,true"</item>
        <item>"wifi_p2p,13,1,0,-1,true"</item>
        <item>"mobile_ia,14,0,2,-1,true"</item>
        <item>"mobile_emergency,15,0,2,-1,true"</item>
        <item>"mobile_bip,23,0,2,60000,true"</item>
        <item>"mobile_cas,24,0,3,60000,true"</item>
        <item>"mobile_ent1,28,0,2,-1,true"</item>
        <item>"mobile_mcx,32,0,2,-1,true"</item>
        <item>"mobile_foc,30,0,2,-1,true"</item>
    </string-array>

    <string-array translatable="false" name="radioAttributes">
        <item>"1,1"</item>
        <item>"0,1"</item>
    </string-array>

    <string-array translatable="false" name="config_globalActionsList">
        <item>emergency</item>
        <item>lockdown</item>
        <item>power</item>
        <item>restart</item>
        <item>logout</item>
        <item>screenshot</item>
        <item>bugreport</item>
    </string-array>

    <!-- Keep fewer cached apps resident on the 3GB RAM SM-P205. -->
    <integer name="config_customizedMaxCachedProcesses">24</integer>

    <!-- The Samsung flip-cover Hall sensor is wired as the standard lid switch. -->
    <bool name="config_lidControlsSleep">true</bool>

    <!-- The COD3035 jack driver reports headset state through /dev/input switches. -->
    <bool name="config_useDevInputEventForAudioJack">true</bool>

    <!-- Approximate Samsung palm swipe capture through Android's screenshot service. -->
    <bool name="config_enablePalmSwipeScreenshot">true</bool>

    <!-- Approximate Samsung Multi window / Pop-up view with Android freeform windows. -->
    <bool name="config_freeformWindowManagement">true</bool>
    <integer name="config_supportsNonResizableMultiWindow">1</integer>

    <!-- Approximate Samsung Daily Board with Android's charging photo-frame dream. -->
    <bool name="config_dreamsActivatedOnSleepByDefault">true</bool>
    <string name="config_dreamsDefaultComponent" translatable="false">com.android.dreams.phototable/com.android.dreams.phototable.FlipperDream</string>

</resources>
